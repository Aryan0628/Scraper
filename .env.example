# Neon connection string (Dashboard -> Connection Details -> pooled connection).
# Region: use ap-southeast-1 (Singapore) from India -- ~100ms vs ~525ms Ohio.
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Logged-in session, for authenticated body fetches. LOCAL runs read
# .secrets/storageState.json (created by `node scripts/login.ts`).
# GCP runs read OA_SESSION instead -- the storageState JSON, or its base64.
# Refresh it when it expires (the crawler stops loudly with "SESSION DEAD").
#   base64 -i .secrets/storageState.json | pbcopy   # then paste into Secret Manager
# OA_SESSION=

# Optional: seconds*1000 between question views. Default 26000 (~138/hour, under
# the 150/hour cap). Lower only for testing against a throwaway account.
# VIEW_INTERVAL_MS=26000
